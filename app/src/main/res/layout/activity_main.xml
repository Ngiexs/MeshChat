<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/welcomeText"
            style="@style/Brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MeshChat"
            android:layout_marginBottom="4dp"/>

        <TextView
            style="@style/Tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Encrypted mesh over Tor"
            android:layout_marginBottom="28dp"/>

        <TextView style="@style/SectionLabel" android:text="YOUR GROUPS"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <Spinner
                android:id="@+id/groupSpinner"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@color/surface_hi"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/newGroupBtn"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:minWidth="0dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="+ New"
                android:textColor="#0A0E13"
                android:textStyle="bold"
                android:textSize="14sp"
                android:background="@color/accent"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <TextView style="@style/SectionLabel" android:text="GROUP"/>

        <EditText
            android:id="@+id/groupNameInput"
            style="@style/Field"
            android:hint="Group name"
            android:inputType="text"
            android:maxLines="1"/>

        <EditText
            android:id="@+id/passphraseInput"
            style="@style/Field"
            android:hint="Group passphrase"
            android:inputType="textPassword"
            android:maxLines="1"/>

        <TextView
            style="@style/Hint"
            android:text="Same name and passphrase on every device."/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <Button
                android:id="@+id/pasteCredsBtn"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Paste credentials"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:background="@color/surface_hi"
                android:layout_marginEnd="6dp"/>

            <Button
                android:id="@+id/scanQrBtn"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Scan QR"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:background="@color/surface_hi"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <TextView style="@style/SectionLabel" android:text="HOST ONION"/>

        <EditText
            android:id="@+id/onionInput"
            style="@style/FieldMono"
            android:hint="xxxxxxxxxxxxxxxx.onion"/>

        <TextView
            style="@style/Hint"
            android:text="Only needed when joining. Long-press to paste."/>

        <TextView style="@style/SectionLabel" android:text="YOU"/>

        <EditText
            android:id="@+id/nameInput"
            style="@style/Field"
            android:hint="Your name"
            android:inputType="textPersonName"
            android:maxLines="1"/>

        <TextView style="@style/SectionLabel" android:text="ROLE"/>

        <RadioGroup
            android:id="@+id/modeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <RadioButton
                android:id="@+id/hostRadio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Host"
                android:textColor="@color/text"
                android:buttonTint="@color/accent"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/joinRadio"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Join"
                android:textColor="@color/text"
                android:buttonTint="@color/accent"/>
        </RadioGroup>

        <TextView
            android:id="@+id/modeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="You'll be the first member of a new group."
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:layout_marginBottom="14dp"/>

        <CheckBox
            android:id="@+id/backupCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Become a backup node"
            android:textColor="@color/text"
            android:buttonTint="@color/accent"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/backupHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Backups take over if the host disconnects."
            android:textSize="11sp"
            android:textColor="@color/text_muted"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/startBtn"
            style="@style/AccentButton"
            android:text="CONNECT"
            android:layout_marginBottom="18dp"/>

        <Button
            android:id="@+id/deleteGroupBtn"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Delete this group"
            android:textColor="@color/danger"
            android:textSize="13sp"
            android:background="?android:attr/selectableItemBackground"
            android:visibility="gone"/>
    </LinearLayout>
</ScrollView>